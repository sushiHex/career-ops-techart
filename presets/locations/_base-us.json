  "grammar": {
    "_README": [
      "THE shared location grammar. location-core.mjs and scripts/_location.py both compile these",
      "patterns, so the two gates cannot read a location differently. Patterns use only syntax both",
      "regex engines share (no lookbehind, no inline flags, no named groups) and are compiled",
      "case-insensitively. They run on NORMALISED text, where every state the text names has",
      "been replaced by a token like <TX>, so a code can never be confused with a word ('OR',",
      "'IN', 'LA') by the time a pattern reads it. Placeholders: {ST} a state token, {LIST} a",
      "list of tokens, {US} a country marker, {R} a remote word. presets/README.md explains",
      "the rules these patterns implement. The tokeniser's own mechanics (what a code token,",
      "a run of codes or a signal looks like) are code, written the same way in both engines."
    ],
    "folds": [
      [
        "\\bwashington,?\\s*(?:d\\.?\\s*c\\.?|district of columbia)(?![a-z])",
        "District of Columbia"
      ],
      [
        "(?:\\bd\\.?c\\.?|\\bdistrict of columbia)\\s*[,–—-]?\\s*washington\\b",
        "District of Columbia"
      ],
      [
        "\\bnew york,\\s*(?:new york|ny)\\b(?!\\s+city)",
        "New York City, NY"
      ],
      [
        "\\bny,\\s*new york\\b(?!\\s+city)",
        "NY, New York City"
      ],
      [
        "(^|[|;/]\\s*|\\b(?:hybrid|on-?site|in[- ](?:office|person))\\s*[-:–—]\\s*)new york(?=\\s*(?:$|[|;/(,]|or\\b|and\\b|metro|hybrid|area|office))",
        "$1New York City, NY"
      ]
    ],
    "remote": "\\b(?:remote|work from (?:home|anywhere)|wfh|fully distributed)\\b",
    "remote_friendly": "\\bremote[-\\s]?friendly\\b",
    "remote_hybrid": "\\b(?:hybrid[-\\s]+remote|remote[-\\s]+hybrid)\\b",
    "state_as_city": {
      "NY": "New York City, NY"
    },
    "us": "\\b(?:u\\.s\\.a\\.?|u\\.s\\.|usa|us|united states(?: of america)?)(?![a-z0-9])",
    "list_sep": "\\s*(?:,\\s*(?:and|or)\\s+|,|\\s+and\\s+|\\s+or\\s+|&|/)\\s*",
    "city_suffix": "\\s+(?:city|beach|township|twp|springs|heights)\\b",
    "code_before": "(?:^|[,(:/|;&–—-]|\\b(?:or|and|excluding|except|excl\\.?|than|but|(?:reside|residing|live|living|located|based|remote|eligible|available|hiring|anywhere|work|working)\\s+(?:in|within)|residents?\\s+of|state\\s+of))\\s*$",
    "code_after": "\\s*(?:$|[,()|;/]|\\d{5}|[-–—]\\s*(?:$|\\s|remote\\b))|\\s+(?:[-–—]|or\\b|and\\b|remote\\b|excluded\\b|residents?\\b|only\\b|not\\b|ineligible\\b|is\\b|are\\b)",
    "time_zone_words": "\\b(?:(?:central|mountain|pacific|eastern)\\s+(?:standard\\s+|daylight\\s+)?time|time\\s*zones?)\\b",
    "time_zone_abbrev": "\\b(?:PT|PST|PDT|ET|EST|EDT|CST|CDT|MST|MDT)\\b",
    "time_zone_us_paren": "\\b(?:US|USA|U\\.S\\.A?\\.?|United States)\\s*\\(\\s*(?:CT|MT)\\s*\\)",
    "time_zone_codes": [
      "CT",
      "MT"
    ],
    "case_sensitive": [
      "time_zone_abbrev",
      "time_zone_us_paren",
      "sentence_break"
    ],
    "ambiguous_codes": {
      "LA": [
        700,
        714
      ],
      "IN": [
        460,
        479
      ]
    },
    "country_like_codes": [
      "CA",
      "IN"
    ],
    "placeholder": "^\\s*(?:\\d+\\s+locations?|multiple locations|blank|various locations)\\s*$",
    "undetermined": "\\b(?:tbd|tbc|to be (?:confirmed|determined|decided)|location (?:flexible|negotiable)|flexible location|multiple locations|various locations)\\b",
    "travel_phrase": "\\b(?:(?:occasional|some|frequent|periodic|regular)\\s+)?(?:travel(?:ing|s)?|trips?|visits?|visiting)\\b[^)|;,]{0,40}",
    "preference_after": "^[^)|;]{0,30}?\\b(?:preferred|preference|a plus|ideal|nice to have)\\b",
    "context_before": "\\b(?:travel(?:ing|s)?|trips?|visits?|visiting|offices?|hq|headquarter\\w*|based out of)\\b[^)|;]{0,30}$",
    "negation_before": "\\b(?:not|no longer|never)\\s+$",
    "nationwide": "\\b(?:nationwide|any (?:us |u\\.s\\. )?state|all (?:us |u\\.s\\. )?states|anywhere(?:\\s+(?:in|within|across)\\s+(?:the\\s+)?(?:us|u\\.s\\.a?\\.?|usa|united states|country|north america))?(?!\\s+(?:in|within|across|except|outside|but)\\b))(?![a-z0-9])",
    "exclusion_lead": "(?:\\b(?:except(?:\\s+for)?|excluding|excludes|excl\\.?|other than|not available(?:\\s+(?:to|in))?|not eligible(?:\\s+(?:in|for))?|not open to|cannot hire in|can'?t hire in|not hiring in|anywhere but|all (?:us |u\\.s\\. )?states but|excluded(?:\\s+states)?\\s*:)|(?:^|[(,:\\u2013\\u2014-])\\s*outside(?:\\s+of)?)\\s*:?\\s*(?:the\\s+)?(?:following\\s+)?(?:(?:states?|locations?)(?:\\s+of)?\\s*:?\\s*)?(?:(?:residents|candidates|applicants|employees|those|people)\\s+(?:of|in|from|based in|located in|residing in)\\s+)?(?:in\\s+)?(?:the\\s+state\\s+of\\s+)?({LIST})",
    "exclusion_trail": "({LIST})\\s*(?:(?:residents|candidates|applicants|employees)\\s+)?(?:(?:is|are)\\s+)?(?:excluded|not eligible|ineligible)\\b",
    "weak_context": [
      "\\b(?:travel(?:ing|s)?|trips?|visits?|visiting|offices?|hq|headquarter\\w*|based out of|preferred|preference|prefer|ideally)\\b[^)|;]{0,40}?({LIST})",
      "({LIST})\\s*(?:is\\s+|are\\s+)?(?:strongly\\s+)?(?:preferred|a plus|ideal|nice to have)\\b",
      "({LIST})\\s*(?:offices?|hq|headquarters?)\\b"
    ],
    "scope_shapes": [
      "{US}\\s*,\\s*({LIST})\\s*[,(]",
      "{US}\\s*[-\\u2013\\u2014,]\\s*{R}\\s*[-\\u2013\\u2014,:(]\\s*({LIST})",
      "^\\s*({LIST})\\s*,\\s*{US}\\s*[-\\u2013\\u2014(,]\\s*{R}",
      "^\\s*(?:{US}\\s*[-\\u2013\\u2014,]\\s*)?({LIST})(?:\\s+state)?(?:\\s*[-\\u2013\\u2014,(]\\s*|\\s+){R}",
      "{R}\\s*(?:[-\\u2013\\u2014:,(]\\s*|\\s+(?:in|within)\\s*:?\\s*|\\s+)(?:(?:eligible|available|open|hiring|located|based)\\s+(?:in\\s*:?\\s*)?|(?:eligible\\s+)?(?:states?|locations?)\\s*:\\s*|eligible\\s*:\\s*)?({LIST})(?![^|;()]*?\\b(?:preferred|a plus|ideal|nice to have)\\b)",
      "{R}\\s*[-\\u2013\\u2014(,:]?\\s*\\(?\\s*{US}\\s*\\)?\\s*(?:[-\\u2013\\u2014(,:]\\s*|\\s+)\\(?\\s*(?:only\\s+)?({LIST})(?![^|;()]*?\\b(?:preferred|a plus|ideal|nice to have)\\b)",
      "\\b(?:must|required to|need to|should)\\s+(?:currently\\s+)?(?:reside|live|be located|be based)\\s+(?:in|within)\\s+(?:the\\s+)?(?:states?\\s+of\\s+)?({LIST})",
      "\\b(?:residents|residing)\\s+(?:of|in)\\s+({LIST})\\s+only\\b",
      "\\banywhere\\s+(?:in|within|across)\\s+(?:the\\s+)?(?:states?\\s+of\\s+)?({LIST})"
    ],
    "metro_scope": "^\\s*({ST})\\s*[-\\u2013\\u2014]\\s*((?:[^-\\u2013\\u2014|;]{1,40}[-\\u2013\\u2014]\\s*){1,2}){R}\\s*$",
    "chunk_split": "\\s*(?:[|;\\u00b7\\u2022\\n]|:\\s+)\\s*",
    "sentence_break": "([a-z)][a-z)])\\.\\s+(?=[A-Z])",
    "place_split": "\\s+(?:or|and|with)\\s+|\\s*[/&]\\s*|,\\s*(?=[A-Za-z][A-Za-z.' -]*,\\s*<[A-Z]{2}>)",
    "place_donor": "^[^<]*[A-Za-z][^<]*,\\s*<[A-Z]{2}>",
    "place_break": [
      "(^|[,(|;/]\\s*)(?!(?:us|usa|u\\.s\\.a?\\.?|united states(?: of america)?)\\s*,)([A-Za-z][A-Za-z.' ]*,\\s*<[A-Z]{2}>)\\s*,\\s*(?=[A-Za-z])",
      "$1$2 / "
    ]
  },
