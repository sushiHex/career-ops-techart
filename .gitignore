# Personal data (user fills these). Anchored to the root so the fictional
# examples/**/cv.md files stay tracked.
/cv.md
/article-digest.md
/redactions.yml
/voice-dna.md

# Pipeline output written to the root (dispositions.json carries requisition URLs and
# rejection reasons) and any ad-hoc JSON/YAML capture dropped beside it.
/*.json
!/package.json
!/renovate.json
/*.yml
batch/*-list.txt
batch/*-urls.txt
data/applications.md
data/applications.db
data/pipeline.md
data/scan-history.tsv
data/follow-ups.md
data/parser-output/**/*.json
!data/parser-output/.gitkeep
!data/parser-output/**/.gitkeep
data/cache/
reports/*.md
reports/superseded/
!reports/.gitkeep
output/*
!output/.gitkeep
batch/logs/*
!batch/logs/.gitkeep
batch/batch-state.tsv
batch/batch-input.tsv
batch/tracker-additions/**/*.tsv
!batch/tracker-additions/.gitkeep
batch/eval-queue/
jds/*
!jds/.gitkeep
interview-prep/*
!interview-prep/.gitkeep
writing-samples/*
!writing-samples/README.md
research/

# User configuration, written by `node setup.mjs` (see AGENTS.md).
config/profile.yml
config/lane-vocab.json
config/location.json
# Anchored: test-fixtures/portals.yml is a tracked fixture the self-tests need.
/portals.yml
modes/_profile.md

# Generated by the pipeline on every run
data/location-rejects.tsv
data/title-vetoes.tsv
data/already-evaluated.tsv
data/board-probe.json
data/board-probe-portals-patch.yml
data/comp-basis.json
data/link-refresh-state.json
data/liveness-delta.json
data/board-build-state.json
data/.board-build.lock
reports/*-RESERVED.md
*.bak
.resolved-prompt-*

# Secrets (never commit; use .env.example as the template)
.env

# Dependencies and build output
node_modules/
bun.lock
package-lock.json
career-dashboard
career-dashboard.exe
tmp/
scripts/.tmp/
__pycache__/

# CLI-local state
.claude/settings.local.json
.claude/memory/
.claude/commands/
.opencode/settings.local.json
.opencode/memory/
.playwright-mcp/
.superpowers/
plan/

# OS and media
.DS_Store
*.mov
*.mp4
